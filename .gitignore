# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Raw downloaded mirrors (reproducible via scripts/01_build_poc_dataset.py)
data/raw/

# Regenerable full build artefacts (rerun scripts/01_build_poc_dataset.py).
# The small representative_set.csv + summary.json ARE committed as the
# stage-1 deliverable snapshot.
data/processed/**/*.parquet
data/processed/**/curated.csv

# Stage 2a prep: keep the per-molecule handoff files + manifests + batch report,
# but drop the regenerable antechamber/tleap debug scratch.
data/prep/**/intermediates/
data/prep/_errors/

# Local conda install (bootstrapped by scripts/setup_conda_env.sh)
miniconda3/

# Stage 2b MD outputs (trajectories/checkpoints are large & regenerable)
data/md/
data/md_dryrun/
*.dcd
*.xtc
*.trr
*.chk
